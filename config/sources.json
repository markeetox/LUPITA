{
  "note": "ERDDAP dataset IDs and dimensions verified with check_sources. gradient_min values are placeholders to calibrate against real grids.",
  "region": { "name": "south_florida", "lat": [24.5, 27.0], "lon": [-81.0, -78.5] },
  "ndbc": { "realtime_url": "https://www.ndbc.noaa.gov/data/realtime2/{station}.txt" },
  "erddap": {
    "sst": {
      "enabled": true,
      "base": "https://coastwatch.pfeg.noaa.gov/erddap",
      "dataset": "jplMURSST41",
      "variable": "analysed_sst",
      "dims": ["time", "latitude", "longitude"],
      "stride": { "latitude": 2, "longitude": 2 },
      "parameter": "sst_c",
      "log_scale": false,
      "gradient_unit": "degC per km",
      "gradient_min": 0.05
    },
    "chlorophyll": {
      "enabled": true,
      "base": "https://coastwatch.pfeg.noaa.gov/erddap",
      "dataset": "nesdisVHNSQchlaDaily",
      "variable": "chlor_a",
      "dims": ["time", "altitude", "latitude", "longitude"],
      "stride": { "latitude": 2, "longitude": 2 },
      "parameter": "chlorophyll",
      "log_scale": true,
      "gradient_unit": "log10(mg/m3) per km",
      "gradient_min": 0.02,
      "note": "Daily scenes have gaps under cloud; see valid_fraction in the output."
    }
  }
}
