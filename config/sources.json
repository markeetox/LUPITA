    "chlorophyll": {
      "enabled": true,
      "base": "https://coastwatch.pfeg.noaa.gov/erddap",
      "dataset": "nesdisVHNnoaa20chlaDaily",
      "variable": "chlor_a",
      "dims": [
        "time",
        "altitude",
        "latitude",
        "longitude"
      ],
      "stride": {
        "latitude": 2,
        "longitude": 2
      },
      "parameter": "chlorophyll",
