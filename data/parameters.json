      "tier": "v1",
      "status": "active",
      "dynamic": true,
      "confidence": "modeled",
      "sources": [
        {
          "name": "NOAA CO-OPS tide predictions",
          "host": "https://tidesandcurrents.noaa.gov/"
        }
      ],
      "update_rate": "Predictions are fixed in advance; observations about every 6 minutes",
      "notes": "Very important for inshore fish such as snook."
    },
    {
      "key": "time_of_day",
      "label": "Time of day",
      "unit": null,
      "type": "category",
      "values": [
        "dawn",
        "day",
        "dusk",
        "night"
      ],
      "tier": "v1",
      "status": "active",
      "dynamic": true,
      "confidence": "derived",
      "sources": [
        {
          "name": "Calculated from sunrise and sunset at the location",
          "host": "internal"
        }
      ],
      "update_rate": "Computed at run time"
    },
    {
      "key": "wind_speed",
      "label": "Wind speed",
      "unit": "knots",
