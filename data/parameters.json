{
  "schema_version": 1,
  "notes": "Registry of every factor the project can use. Species files may only reference keys defined here. Sources are listed at host level; exact dataset IDs, endpoints and update rates must be confirmed when each pull is built. Add a factor by adding one entry; activate it by changing status to 'active'.",
  "confidence_types": {
    "measured": "Direct sensor reading (buoy, tide gauge, stream gauge)",
    "modeled": "Satellite product or ocean/weather model output",
    "derived": "Calculated by this project from other parameters",
    "seasonal": "Calendar or pattern-based knowledge, not a live measurement",
    "static": "Mapped feature that does not change day to day"
  },
  "tiers": {
    "v1": "Build first. Most reliable data, covers all starter species.",
    "v2": "Add after v1 scoring works.",
    "v3": "Needs extra data sources or more complex processing.",
    "later": "Hard to measure; revisit once core system is proven."
  },
  "parameters": [
    {
      "key": "sst_c",
      "label": "Sea surface temperature",
      "unit": "degC",
      "type": "number",
      "tier": "v1",
      "status": "active",
      "dynamic": true,
      "confidence": "measured",
      "sources": [
        {
          "name": "NOAA NDBC buoys (water temp)",
          "host": "https://www.ndbc.noaa.gov/"
        },
        {
          "name": "NOAA CoastWatch ERDDAP (satellite SST grids)",
          "host": "https://coastwatch.pfeg.noaa.gov/erddap/"
        }
      ],
      "update_rate": "Buoys about hourly; satellite grids daily",
      "notes": "Buoys give exact point values; satellite grids fill the spaces between buoys."
    },
    {
      "key": "sst_gradient",
      "label": "Temperature break strength",
      "unit": "degC per km",
      "type": "number",
      "tier": "v1",
      "status": "active",
      "dynamic": true,
      "confidence": "derived",
      "derived_from": [
        "sst_c"
      ],
      "sources": [
        {
          "name": "Calculated from SST grid",
          "host": "internal"
        }
      ],
      "update_rate": "Daily, with the SST grid",
      "notes": "Fronts concentrate baitfish and pelagics such as mahi."
    },
    {
      "key": "chlorophyll",
      "label": "Chlorophyll-a concentration",
      "unit": "mg/m3",
      "type": "number",
      "tier": "v1",
      "status": "active",
      "dynamic": true,
      "confidence": "modeled",
      "sources": [
        {
          "name": "NOAA CoastWatch ERDDAP (VIIRS chlorophyll)",
          "host": "https://coastwatch.pfeg.noaa.gov/erddap/"
        },
        {
          "name": "NASA Ocean Color",
          "host": "https://oceancolor.gsfc.nasa.gov/"
        }
      ],
      "update_rate": "Daily or multi-day composites; gaps under cloud cover",
      "notes": "Missing data is normal. Scoring must tolerate gaps."
    },
    {
      "key": "depth_m",
      "label": "Water depth",
      "unit": "m",
      "type": "number",
      "tier": "v1",
      "status": "active",
      "dynamic": false,
      "confidence": "static",
      "sources": [
        {
          "name": "NOAA NCEI Coastal Relief Model / bathymetry",
          "host": "https://www.ncei.noaa.gov/"
        },
        {
          "name": "GEBCO",
          "host": "https://www.gebco.net/"
        }
      ],
      "update_rate": "Static; refresh only when new survey data is released"
    },
    {
      "key": "structure_type",
      "label": "Bottom structure",
      "unit": null,
      "type": "category",
      "values": [
        "natural_reef",
        "artificial_reef",
        "wreck",
        "ledge",
        "hardbottom",
        "seagrass",
        "mangrove_edge",
        "open_sand"
      ],
      "tier": "v1",
      "status": "active",
      "dynamic": false,
      "confidence": "static",
      "sources": [
        {
          "name": "FWC artificial reef and reef habitat data",
          "host": "https://myfwc.com/"
        },
        {
          "name": "NOAA habitat and benthic maps",
          "host": "https://www.ncei.noaa.gov/"
        }
      ],
      "update_rate": "Static; refresh when agencies publish updates"
    },
    {
      "key": "current_speed",
      "label": "Surface current speed",
      "unit": "knots",
      "type": "number",
      "tier": "v1",
      "status": "active",
      "dynamic": true,
      "confidence": "modeled",
      "sources": [
        {
          "name": "NOAA RTOFS",
          "host": "https://polar.ncep.noaa.gov/"
        },
        {
          "name": "HYCOM",
          "host": "https://www.hycom.org/"
        },
        {
          "name": "NOAA CO-OPS tidal currents (nearshore)",
          "host": "https://tidesandcurrents.noaa.gov/"
        }
      ],
      "update_rate": "Model forecasts daily or better",
      "notes": "Matters a lot near the Gulf Stream edge off Miami."
    },
    {
      "key": "tide_stage",
      "label": "Tide stage",
      "unit": null,
      "type": "category",
      "values": [
        "rising",
        "falling",
        "slack_high",
        "slack_low"
